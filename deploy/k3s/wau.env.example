# Every key of the Secret wau-env. Copy to wau.env (git-ignored), fill in, then:
#   kubectl -n wau create secret generic wau-env --from-env-file=deploy/k3s/wau.env
# Values are taken as written, without quotes. Per-app addresses and URLs are in each app's
# manifest instead.

# RDS, user wau_app (owner of wau_captcha), never the master user. In the URL, percent-encode
# any special character of the password.
KRATOS_DATABASE_SOURCE=postgres://wau_app:<APP_PASSWORD>@wau-captcha.ctyiqygq6ujb.ap-southeast-1.rds.amazonaws.com:5432/wau_captcha?sslmode=require&pool_max_conns=2
# The same account for the migration Job (plain password here).
PGUSER=wau_app
PGPASSWORD=<APP_PASSWORD>

# ElastiCache Serverless (Valkey): its endpoint, always TLS, no password set (any string works).
KRATOS_REDIS_ADDRS=<endpoint ElastiCache>:6379
KRATOS_REDIS_PASSWORD=unused
KRATOS_REDIS_TLS=true

# Random secrets, e.g. openssl rand -base64 48. KRATOS_AUTH_SECRET (tenant and billing) needs
# at least 32 bytes.
KRATOS_TOKEN_SECRET=<TOKEN_SECRET>
KRATOS_AUTH_SECRET=<AUTH_SECRET>

# The Google OAuth client ID, the same in both: tenant checks ID tokens issued for the
# dashboard's client.
KRATOS_GOOGLE_CLIENT_ID=<CLIENT_ID>.apps.googleusercontent.com
GOOGLE_CLIENT_ID=<CLIENT_ID>.apps.googleusercontent.com

# SePay payment gateway (my.sepay.vn); the sandbox is https://pay-sandbox.sepay.vn/v1/checkout/init.
SEPAY_MERCHANT_ID=<MERCHANT_ID>
SEPAY_SECRET_KEY=<SEPAY_SECRET_KEY>
SEPAY_CHECKOUT_URL=https://pay.sepay.vn/v1/checkout/init
